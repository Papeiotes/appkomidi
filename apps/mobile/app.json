{
  "expo": {
    "name": "APPkomidi",
    "slug": "appkomidi",
    "scheme": "appkomidi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Το APPkomidi στέλνει τη θέση του οδηγού για την ειδοποίηση άφιξης στα 50 μέτρα."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f4a34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Το APPkomidi στέλνει τη θέση του οδηγού για την ειδοποίηση άφιξης στα 50 μέτρα."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4107"
    }
  }
}
