generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OFFICE
  DRIVER
  BUSINESS
}

enum BinType {
  GREEN
  BLUE
  YELLOW
  BROWN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuantityBracket {
  KG_0_10
  KG_10_20
  KG_20_50
  KG_50_PLUS
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  PAUSED
  ENDED
}

model Municipality {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  users      User[]
  businesses Business[]
  trucks     Truck[]
  shifts     Shift[]
  bookings   Booking[]
  subAreas   SubArea[]
  createdAt  DateTime   @default(now())
}

model User {
  id             String       @id @default(cuid())
  username       String       @unique
  passwordHash   String
  role           Role
  name           String
  phone          String?
  locale         String       @default("el")
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  permissions    String[]     @default([])
  pushToken      String?
  business       Business?
  driverShifts   Shift[]      @relation("ShiftDriver")
  linkedTrucks   Truck[]      @relation("DriverTruck")
  createdAt      DateTime     @default(now())
}

model Business {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  municipalityId String
  municipality   Municipality   @relation(fields: [municipalityId], references: [id])
  name           String
  afm            String
  phone          String
  contactName    String
  street         String
  streetNumber   String
  addressLabel   String
  lat            Float
  lng            Float
  status         BusinessStatus @default(PENDING)
  rejectionNote  String?
  subAreaId      String?
  subArea        SubArea?       @relation(fields: [subAreaId], references: [id])
  bookings       Booking[]
  createdAt      DateTime       @default(now())

  @@index([municipalityId, status])
}

model SubArea {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  name           String
  ring           Json
  businesses     Business[]
}

model Truck {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  binType        BinType
  capacityKg     Int
  plate          String       @default("")
  active         Boolean      @default(true)
  driverId       String?
  driver         User?        @relation("DriverTruck", fields: [driverId], references: [id])
  shifts         Shift[]
}

model Shift {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  truckId        String
  truck          Truck        @relation(fields: [truckId], references: [id])
  driverId       String
  driver         User         @relation("ShiftDriver", fields: [driverId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  status         ShiftStatus  @default(SCHEDULED)
  routeLocked    Boolean      @default(false)
  routeOrder     String[]     @default([])
  cursor         Int          @default(0)
  lastLat        Float?
  lastLng        Float?
  lastPingAt     DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  bookings       Booking[]
  closures       SlotClosure[]
  pings          LocationPing[]
  createdAt      DateTime     @default(now())

  @@index([municipalityId, startsAt])
  @@index([driverId, startsAt])
}

model SlotClosure {
  id       String   @id @default(cuid())
  shiftId  String
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  slotAt   DateTime

  @@unique([shiftId, slotAt])
}

model Booking {
  id             String           @id @default(cuid())
  municipalityId String
  municipality   Municipality     @relation(fields: [municipalityId], references: [id])
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id])
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id])
  binType        BinType
  bracket        QuantityBracket
  kg             Int
  scheduledAt    DateTime
  status         BookingStatus    @default(CONFIRMED)
  arrivalOpen    Boolean          @default(false)
  arrivalNotified Boolean         @default(false)
  reminderSent   Boolean          @default(false)
  cancelReason   String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())

  @@index([shiftId, status])
  @@index([businessId, scheduledAt])
}

model LocationPing {
  id         String   @id @default(cuid())
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  recordedAt DateTime @default(now())

  @@index([shiftId, recordedAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  titleEl    String
  titleEn    String
  bodyEl     String
  bodyEn     String
  data       Json?
  reply      String?
  repliedAt  DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}
